{
  "name": "cyber",
  "productName": "Cyber",
  "version": "1.0.0",
  "description": "Terminal SSH personnalisable pour Android, Windows et Linux",
  "main": "desktop/main.js",
  "author": {
    "name": "apk-fold",
    "email": "apk-fold@users.noreply.github.com"
  },
  "homepage": "https://github.com/apk-fold/Cyber",
  "private": true,
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "start": "node scripts/build-web.mjs && electron .",
    "dist:win": "node scripts/build-web.mjs && electron-builder --win --x64 --publish never",
    "dist:linux": "node scripts/build-web.mjs && electron-builder --linux --x64 --publish never",
    "test": "node tests/ssh-test.mjs && node tests/pty-test.mjs"
  },
  "dependencies": {
    "node-pty": "^1.0.0",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@fontsource/fira-code": "^5.0.0",
    "@fontsource/jetbrains-mono": "^5.0.0",
    "@xterm/addon-fit": "~0.10.0",
    "@xterm/addon-search": "~0.15.0",
    "@xterm/addon-unicode11": "~0.8.0",
    "@xterm/addon-web-links": "~0.11.0",
    "@xterm/addon-webgl": "~0.18.0",
    "@xterm/xterm": "~5.5.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "fr.apkfold.cyber",
    "productName": "Cyber",
    "copyright": "apk-fold",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "www/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Cyber",
      "artifactName": "Cyber-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Cyber-Portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "System",
      "icon": "build/icon.png",
      "artifactName": "Cyber-linux.${ext}",
      "synopsis": "Terminal SSH personnalisable",
      "executableName": "cyber"
    },
    "appImage": {
      "artifactName": "Cyber.AppImage"
    }
  }
}
